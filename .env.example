# GEMINI_API_KEY: Optional/Server-side key for Gemini AI claim decomposition & reasoning.
# AI Studio automatically injects this at runtime from user secrets when configured.
GEMINI_API_KEY=

# SERPAPI_API_KEY: Optional/Server-side API key for live Google Search and Google News evidence retrieval.
# Kept strictly server-side on Node.js backend.
SERPAPI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

